---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <article class="article">
    <header class="wrap article__head"><h1 class="article__title">Page not found</h1></header>
    <div class="wrap"><div class="article__body">
      <p class="lead">This address isn’t part of the site. It may have moved when the site was rebuilt.</p>
      <p class="actions">
        <a class="button" href="/">Go to the home page</a>
        <a class="button button--quiet" href="/products/">See products</a>
      </p>
    </div></div>
  </article>
</Base>
