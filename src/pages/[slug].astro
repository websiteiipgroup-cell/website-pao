---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Blocks from '../components/blocks/Blocks.astro';

export async function getStaticPaths() {
  // Slugs used by the system; a CMS page with one of these names is ignored.
  const RESERVED = ['home', 'products', 'news', 'admin', '404'];
  const pages = await getCollection('halaman');
  const steps = pages.filter((p) => typeof p.data.langkah === 'number')
    .sort((a, b) => (a.data.langkah ?? 0) - (b.data.langkah ?? 0));
  return pages
    .filter((p) => !RESERVED.includes(p.id))
    .map((p) => {
      const i = steps.findIndex((s) => s.id === p.id);
      return {
        params: { slug: p.id },
        props: {
          page: p,
          totalSteps: steps.length,
          prev: i > 0 ? steps[i - 1] : null,
          next: i >= 0 && i < steps.length - 1 ? steps[i + 1] : null,
        },
      };
    });
}
const { page, totalSteps, prev, next } = Astro.props;
const hasTitle = page.data.blocks.some((b: any) => b.type === 'judul_halaman' || b.type === 'hero');
---
<Base title={page.data.judul} description={page.data.deskripsi || page.data.ringkasan || undefined} image={page.data.gambar || undefined}>
  {!hasTitle && (
    <header class="wrap article__head"><h1 class="article__title">{page.data.judul}</h1></header>
  )}
  <Blocks blocks={page.data.blocks} page={page} totalSteps={totalSteps} />
  {(prev || next) && (
    <nav class="wrap pager" aria-label="From deposit to refinery" style="margin-top:0;margin-bottom:clamp(56px,8vw,104px)">
      {prev && <a class="pager__prev" href={`/${prev.id}/`}><span>Previous</span>{prev.data.judul}</a>}
      {next && <a class="pager__next" href={`/${next.id}/`}><span>Next</span>{next.data.judul}</a>}
    </nav>
  )}
</Base>
